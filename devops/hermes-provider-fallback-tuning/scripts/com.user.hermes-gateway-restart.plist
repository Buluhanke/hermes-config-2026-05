<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Hermes Gateway Restart — one-shot LaunchAgent

  Use when "hermes gateway restart" is blocked from inside Hermes
  (all Hermes-spawned shells refuse to kill the gateway).

  Install:
    cp com.user.hermes-gateway-restart.plist ~/Library/LaunchAgents/
    launchctl load ~/Library/LaunchAgents/com.user.hermes-gateway-restart.plist

  The agent fires RunAtLoad=true, runs `hermes gateway restart`, and exits.
  Check Console.app or `log show --predicate 'process == "launchd"' --last 1m`
  to see the run.

  To uninstall:
    launchctl unload ~/Library/LaunchAgents/com.user.hermes-gateway-restart.plist
    rm ~/Library/LaunchAgents/com.user.hermes-gateway-restart.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.hermes-gateway-restart</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>-c</string>
        <string>exec hermes gateway restart > /tmp/hermes-gateway-restart.log 2>&1</string>
    </array>

    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/tmp/hermes-gateway-restart.log</string>

    <key>StandardErrorPath</key>
    <string>/tmp/hermes-gateway-restart.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
