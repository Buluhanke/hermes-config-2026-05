{
  "workflow_version": "1.0",
  "name": "Batch Product Image Generator",
  "description": "Generate multiple product image variations in parallel: main product shots, lifestyle shots, and detail close-ups for e-commerce catalogs",
  "category": "batch-generation",
  "config": {
    "batch_size": 4,
    "parallel_jobs": 3,
    "output_format": "PNG",
    "quality": 95
  },
  "nodes": {
    "1": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "sd_xl_base_1.0.safetensors"
      }
    },
    "2": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["1", 1],
        "text": "{main_product_prompt}"
      }
    },
    "3": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["1", 1],
        "text": "{lifestyle_prompt}"
      }
    },
    "4": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["1", 1],
        "text": "{detail_prompt}"
      }
    },
    "5": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": ["1", 1],
        "text": "{negative_prompt}"
      }
    },
    "6": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "batch_size": 3,
        "height": 1024,
        "width": 1024
      }
    },
    "7": {
      "class_type": "KSampler",
      "inputs": {
        "cfg": 7.5,
        "denoise": 1.0,
        "extra_generation_params": {},
        "model": ["1", 0],
        "negative": ["5", 0],
        "positive": ["2", 0],
        "preview_method": "auto",
        "sampler_name": "euler",
        "scheduler": "normal",
        "seed": { "seed": -1, "control_after_generate": "increment" },
        "steps": 30
      }
    },
    "8": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "batch_size": 2,
        "height": 1024,
        "width": 1024
      }
    },
    "9": {
      "class_type": "KSampler",
      "inputs": {
        "cfg": 7.5,
        "denoise": 1.0,
        "extra_generation_params": {},
        "model": ["1", 0],
        "negative": ["5", 0],
        "positive": ["3", 0],
        "preview_method": "auto",
        "sampler_name": "euler",
        "scheduler": "normal",
        "seed": { "seed": -1, "control_after_generate": "increment" },
        "steps": 30
      }
    },
    "10": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "batch_size": 2,
        "height": 1024,
        "width": 1024
      }
    },
    "11": {
      "class_type": "KSampler",
      "inputs": {
        "cfg": 7.5,
        "denoise": 1.0,
        "extra_generation_params": {},
        "model": ["1", 0],
        "negative": ["5", 0],
        "positive": ["4", 0],
        "preview_method": "auto",
        "sampler_name": "euler",
        "scheduler": "normal",
        "seed": { "seed": -1, "control_after_generate": "increment" },
        "steps": 30
      }
    },
    "12": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["7", 0],
        "vae": ["1", 2]
      }
    },
    "13": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["9", 0],
        "vae": ["1", 2]
      }
    },
    "14": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["11", 0],
        "vae": ["1", 2]
      }
    },
    "15": {
      "class_type": "ImageScale",
      "inputs": {
        "crop": "center",
        "height": 1024,
        "method": "lanczos",
        "width": 1024,
        "image": ["12", 0]
      }
    },
    "16": {
      "class_type": "ImageScale",
      "inputs": {
        "crop": "center",
        "height": 1024,
        "method": "lanczos",
        "width": 1024,
        "image": ["13", 0]
      }
    },
    "17": {
      "class_type": "ImageScale",
      "inputs": {
        "crop": "center",
        "height": 1024,
        "method": "lanczos",
        "width": 1024,
        "image": ["14", 0]
      }
    },
    "18": {
      "class_type": "ImageConcatenate",
      "inputs": {
        "images": [["15", 0], ["16", 0], ["17", 0]]
      }
    },
    "19": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "batch_main",
        "images": ["15", 0]
      }
    },
    "20": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "batch_lifestyle",
        "images": ["16", 0]
      }
    },
    "21": {
      "class_type": "SaveImage",
      "inputs": {
        "filename_prefix": "batch_detail",
        "images": ["17", 0]
      }
    }
  },
