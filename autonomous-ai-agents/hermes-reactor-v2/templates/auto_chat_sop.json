{
  "name": "AI自动对话-深度研究",
  "description": "向AI站发送深度研究问题,等待完整回复,提取关键洞察,自动继续追问",
  "version": "1.0",
  "author": "Hermes Reactor v2",
  "stuck_threshold_cycles": 18,
  "stages": [
    {
      "name": "INIT",
      "desc": "初始化, 确认页面就绪",
      "expect": "textarea存在",
      "max_cycles": 5,
      "actions": ["scan_page_state", "verify_input_visible"]
    },
    {
      "name": "TYPE_QUESTION",
      "desc": "输入初始问题到textarea",
      "expect": "textarea.value.length > 0",
      "actions": ["set_textarea_value", "dispatch_input_event"]
    },
    {
      "name": "SEND_QUESTION",
      "desc": "点击发送按钮或按Enter",
      "expect": "textarea清空 + 出现用户消息",
      "actions": ["find_send_button_or_enter"]
    },
    {
      "name": "WAITING_THINKING",
      "desc": "AI 思考阶段 (深度思考模式可能30-90s)",
      "expect": "isLoading=true 或 body持续增长",
      "max_cycles": 60,
      "early_exit": "body不再增长 + bodyLen > 500"
    },
    {
      "name": "WAITING_REPLY",
      "desc": "AI 正在输出回复",
      "expect": "bodyLen单调增长",
      "max_cycles": 90,
      "early_exit": "bodyLen连续3周期不增长"
    },
    {
      "name": "EXTRACT_INSIGHT",
      "desc": "提取回复关键洞察 (用网络请求或API)",
      "actions": ["copy_reply_text", "save_to_knowledge_base"]
    },
    {
      "name": "FOLLOW_UP",
      "desc": "基于洞察自动追问一个深度问题",
      "actions": ["generate_followup_question", "loop_to_TYPE_QUESTION"]
    },
    {
      "name": "COMPLETED",
      "desc": "对话完成",
      "actions": ["log_session_summary", "notify_user"]
    }
  ],
  "loops": {
    "FOLLOW_UP": {
      "max_iterations": 3,
      "on_max": "COMPLETED"
    }
  },
  "cooldowns": {
    "TYPE_QUESTION": 2,
    "SEND_QUESTION": 5,
    "EXTRACT_INSIGHT": 10
  },
  "self_heal": {
    "stuck_threshold": 18,
    "on_trigger": "回到 INIT 阶段, 重置状态",
    "max_retries_per_stage": 2
  }
}
